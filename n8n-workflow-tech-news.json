        460,
        420
      ]
    },
    {
      "parameters": {
        "url": "https://github.blog/feed/"
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000005",
      "name": "RSS - GitHub Blog",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        460,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalizar y limitar noticias de los feeds\nconst items = $input.all();\nconst cleaned = [];\nconst seenTitles = new Set();\n\nfor (const item of items) {\n  const json = item.json;\n  const title = (json.title || '').trim();\n  if (!title || seenTitles.has(title.toLowerCase())) continue;\n  seenTitles.add(title.toLowerCase());\n\n  // Limpieza de extracto HTML\n  let rawSnippet = json.contentSnippet || json.content || json.description || '';\n  rawSnippet = rawSnippet.replace(/<[^>]*>?/gm, '').replace(/\\s+/g, ' ').trim().slice(0, 400);\n\n  cleaned.push({\n    title: title,\n    link: json.link || json.guid || '',\n    pubDate: json.pubDate || new Date().toISOString(),\n    source: json.creator || json['dc:creator'] || 'Tech News',\n    snippet: rawSnippet\n  });\n}\n\n// Tomar las 10 noticias más relevantes\nreturn [{ json: { raw_news: cleaned.slice(0, 10) } }];"
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000006",
      "name": "Filtrar & Limpiar Feeds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        340
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres el editor jefe de un portal tecnológico en español de alta gama. Toma el siguiente arreglo de noticias y genera un arreglo JSON estructurado, traducido al español con estilo periodístico elegante y profesional.\n\nNoticias crudas:\n{{ JSON.stringify($json.raw_news) }}\n\nDebes responder ÚNICAMENTE con un bloque JSON válido con este formato exacto (sin texto adicional ni explicaciones):\n{\n  \"ultima_actualizacion\": \"{{ $now.toISO() }}\",\n  \"agente\": \"n8n Autonomous News Engine (Gemini)\",\n  \"total\": 10,\n  \"noticias\": [\n    {\n      \"id\": \"news-1\",\n      \"titulo\": \"Titular en español cautivador y conciso\",\n      \"categoria\": \"Inteligencia Artificial | Videojuegos | Tecnología | Software & Dev\",\n      \"categoria_slug\": \"ia | gaming | tecnologia | software\",\n      \"destacada\": true,\n      \"resumen\": \"Resumen conciso y profesional de 2 párrafos.\",\n      \"contenido_extendido\": \"Detalles técnicos complementarios relevantes.\",\n      \"imagen\": \"https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1200&q=80\",\n      \"fecha\": \"{{ $now.format('dd MMM yyyy') }}\",\n      \"tiempo_lectura\": \"3 min\",\n      \"fuente_nombre\": \"Nombre del medio\",\n      \"fuente_url\": \"URL original\",\n      \"tags\": [\"Tag1\", \"Tag2\", \"Tag3\"]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000007",
      "name": "Gemini AI Synthesizer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        940,
        340
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/King1Angel/tech-news/contents/data/noticias.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer TU_GITHUB_PERSONAL_ACCESS_TOKEN"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-TechNews-Updater"
            }
          ]
        },
        "options": {}
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000008",
      "name": "Obtener SHA Actual de GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extraer el JSON generado por Gemini y codificar a Base64\nconst geminiOutput = $('Gemini AI Synthesizer').first().json.text;\nconst currentFileSha = $json.sha;\n\n// Limpiar posibles bloques ```json ``` de la respuesta\nlet cleanJson = geminiOutput.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/\\s*```$/, '').trim();\n\n// Validar que sea JSON parseable\nlet parsed = JSON.parse(cleanJson);\nlet jsonString = JSON.stringify(parsed, null, 2);\n\n// Base64 requerido por la API de GitHub\nlet base64Content = Buffer.from(jsonString, 'utf-8').toString('base64');\n\nreturn [{\n  json: {\n    message: `Auto-update: Noticias tech ${new Date().toISOString().slice(0, 10)} [n8n agent]`,\n    content: base64Content,\n    sha: currentFileSha\n  }\n}];"
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000009",
      "name": "Preparar Commit Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        340
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "https://api.github.com/repos/King1Angel/tech-news/contents/data/noticias.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer TU_GITHUB_PERSONAL_ACCESS_TOKEN"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.v3+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-TechNews-Updater"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.message }}\",\n  \"content\": \"{{ $json.content }}\",\n  \"sha\": \"{{ $json.sha }}\",\n  \"branch\": \"main\"\n}",
        "options": {}
      },
      "id": "e1f10001-a1b2-4c3d-8e4f-000000000010",
      "name": "GitHub API - Actualizar noticias.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        340
      ]
    }
